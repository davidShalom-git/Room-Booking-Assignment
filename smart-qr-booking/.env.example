# Copy to .env (local) or set in the Vercel dashboard (production).
# See README.md for what each value is and where to get it.

# --- Site -------------------------------------------------------------------
# Public URL the QR codes and pay links point to.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local: `npm run db:up` starts Postgres 16 in Docker on port 55432.
# Production: a Neon (or any Postgres 14+) connection string. Needs the
# btree_gist extension (Neon, Supabase and RDS all allow it).
DATABASE_URL=postgresql://coral:coral@localhost:55432/coral
# Production only: Neon's direct (non-pooler) URL, used by `prisma migrate deploy` during the Vercel build.
# Same as DATABASE_URL without "-pooler" in the host. Leave empty locally.
DIRECT_DATABASE_URL=
# Separate DB for `npm test` so tests never touch dev data (`npm run db:up` creates it).
TEST_DATABASE_URL=postgresql://coral:coral@localhost:55432/coral_test

# --- Admin login ------------------------------------------------------------
# The first owner password, until the owner sets their own in Settings (then ignored).
ADMIN_PASSWORD=change-me
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-a-long-random-string

# --- Owner app notifications (Web Push) -------------------------------------
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Payments (manual UPI advance) -----------------------------------------
# Optional: used until the owner saves a UPI ID in Settings.
UPI_ID=
UPI_PAYEE_NAME=
# How long an unpaid booking holds the room, in minutes.
HOLD_MINUTES=120

# --- Cron -------------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/*.
CRON_SECRET=
